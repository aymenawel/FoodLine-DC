# Optional: lets FoodLine use Claude to understand messy messages and word replies more warmly.
# 1. Copy this file and rename the copy to  .env.local  (same folder: web/)
# 2. Paste your key after the = sign (no quotes, no spaces)
# 3. Restart FoodLine (npm run stop, then npm run demo)
# Without a key everything still works, using the built-in English and Spanish replies.
ANTHROPIC_API_KEY=

# Set to "off" to switch the AI off without deleting your key:
# FOODLINE_AI=off
