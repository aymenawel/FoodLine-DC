{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "start"
      ],
      "port": 3000,
      "url": "http://localhost:3000"
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 3000,
      "url": "http://localhost:3000"
    },
    {
      "name": "design-preview",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4400",
        "--bind",
        "127.0.0.1"
      ],
      "port": 4400,
      "url": "http://127.0.0.1:4400"
    }
  ]
}